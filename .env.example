# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает никогда.

# --- Telegram ---
# Токен бота из @BotFather → /mybots → API Token
TELEGRAM_BOT_TOKEN=
# Произвольная длинная случайная строка. Генерируется один раз, задаётся и здесь,
# и в setWebhook. Telegram присылает её в заголовке X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Белый список chat_id через запятую. Свой id можно узнать у @userinfobot.
ALLOWED_CHAT_IDS=

# --- Смысловой слой (необязателен) ---
# Ключ Google AI Studio: https://aistudio.google.com/apikey
# Без ключа бот работает на слое правил и честно об этом пишет.
GEMINI_API_KEY=
# Быстрая модель текущего поколения. Сверяйтесь со списком в документации:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Хранилище профилей ---
# Upstash Redis, бесплатный тариф: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Пределы разбора (можно не трогать) ---
# Сколько запросов уходит в модель за один прогон
MAX_TERMS_TO_AI=200
# Размер одного пакета запросов к модели
AI_BATCH_SIZE=100
# Таймаут одного вызова модели, мс
AI_TIMEOUT_MS=45000
# Порог расхода для метки «сливает деньги», в валюте аккаунта
MIN_SPEND_FOR_MONEY_FLAG=1
# Предел размера входного файла, байт
MAX_FILE_BYTES=10485760
# Предел числа строк в CSV
MAX_CSV_ROWS=20000
# Сколько живёт незавершённый диалог /newproject, секунд
DIALOG_TTL_SECONDS=900
# Сколько помнить обработанный update, чтобы не разбирать файл дважды, секунд
UPDATE_DEDUPE_TTL_SECONDS=3600
